<% identity = Rails.configuration.x.foundation %>
<% title "Guestbook" %>

<section class="mx-auto max-w-5xl px-4 py-10 sm:px-6" aria-labelledby="guestbook-title">
  <header class="mb-8">
    <p class="text-sm font-medium uppercase tracking-wide text-md-primary"><%= identity[:application_name] %></p>
    <h1 id="guestbook-title" class="mt-2 text-3xl font-semibold">Sign the guestbook</h1>
    <p class="mt-2 max-w-2xl text-md-on-surface-variant">Leave a short message and it lands on the wall below, newest first. No account needed — it really is this small.</p>
  </header>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:items-start">
    <div>
      <%= form_with model: @message, class: "md-card md-card--filled p-5", aria: { label: "Leave a message" } do |form| %>
        <h2 class="mb-4 text-lg font-semibold">Leave a message</h2>
        <%= render "foundation/components/text_field", form: form, attribute: :name, label: "Name (optional)", hint: "60 characters max" %>
        <%= render "foundation/components/text_field", form: form, attribute: :body, label: "Message", type: :text_area, hint: "280 characters max" %>
        <%= render "foundation/components/button", label: "Post to the wall", variant: :filled, attributes: { type: :submit, class: "mt-2 w-full" } %>
      <% end %>
    </div>

    <div aria-live="polite">
      <h2 class="mb-4 text-xl font-semibold">The wall</h2>
      <% if @messages.any? %>
        <ol class="space-y-3">
          <% @messages.each do |entry| %>
            <li>
              <article class="md-card md-card--outlined p-4">
                <header class="flex items-baseline justify-between gap-3">
                  <strong><%= entry.display_name %></strong>
                  <time datetime="<%= entry.created_at.iso8601 %>" class="text-sm text-md-on-surface-variant"><%= entry.created_at.strftime("%b %e, %Y") %></time>
                </header>
                <p class="mt-2 whitespace-pre-wrap break-words"><%= entry.body %></p>
                <% if user_signed_in? && current_user.admin? %>
                  <div class="mt-2">
                    <%= button_to "Remove", guestbook_entry_path(entry), method: :delete,
                          class: "md-button md-button--text",
                          form: { data: { turbo_confirm: "Remove this message?" } } %>
                  </div>
                <% end %>
              </article>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="md-card md-card--outlined p-5 text-md-on-surface-variant">No messages yet — be the first to sign the wall.</p>
      <% end %>
    </div>
  </div>
</section>
